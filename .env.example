# Non-secret local development defaults.
ATLAS_APP_NAME=Aricoma Atlas
ATLAS_APP_VERSION=0.4.3
ATLAS_ENVIRONMENT=development
ATLAS_API_PREFIX=/api
ATLAS_LOG_LEVEL=INFO
ATLAS_OPENBAO_URL=http://127.0.0.1:18200
ATLAS_OPENBAO_IDENTITY_FILE=.runtime/openbao-backend.json
ATLAS_CREDENTIAL_WRITER_IDENTITY_FILE=.runtime/openbao-credential-writer.json
ATLAS_NETBOX_URL=http://127.0.0.1:8000
ATLAS_OXIDIZED_URL=http://127.0.0.1:8888
ATLAS_ZABBIX_URL=http://127.0.0.1:8082/api_jsonrpc.php
ATLAS_MONITORING_CONFIG_FILE=.runtime/monitoring/config.yaml
ATLAS_MONITORING_JOBS_DIRECTORY=.runtime/monitoring/jobs
ATLAS_MONITORING_IDENTITY_FILE=.runtime/openbao-monitoring.json
ATLAS_MONITORING_OPERATOR_TOKEN_FILE=.runtime/monitoring/operator-token
# Optional HTTPS links displayed by the Operations UI.
# ATLAS_NETBOX_UI_URL=https://netbox.atlas.test/
# ATLAS_OXIDIZED_UI_URL=https://oxidized.atlas.test/
# ATLAS_ZABBIX_UI_URL=https://zabbix.atlas.test/
ATLAS_OXIDIZED_INVENTORY_FILE=/run/atlas/oxidized/router.json
ATLAS_PROPHYLAXIS_RESULTS_FILE=/run/atlas/prophylaxis/results.sqlite3
ATLAS_VPN_REGISTRY_FILE=/run/atlas/vpn/connections.sqlite3
ATLAS_PROPHYLAXIS_RESULT_RETENTION=10000
ATLAS_ANSIBLE_PROJECT_DIR=automation
ATLAS_ANSIBLE_JOB_TIMEOUT=120
ATLAS_SSH_KNOWN_HOSTS_FILE=/run/atlas/ssh/known_hosts
# Development/test default: false. Production deployment sets true explicitly.
ATLAS_SSH_STRICT_HOST_KEYS=false
ATLAS_SSH_CONNECT_TIMEOUT=10
ATLAS_SSH_COMMAND_TIMEOUT=20
ATLAS_FORTIOS_VALIDATE_CERTS=false
ATLAS_HTTP_CONNECT_TIMEOUT=3
ATLAS_HTTP_READ_TIMEOUT=10
