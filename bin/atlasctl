#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
umask 0022

ATLAS_USER="atlas"
ATLAS_GROUP="atlas"
ATLAS_HOME="/home/atlas"
ATLAS_ROOT="/opt/aricoma-atlas"
PYTHON="${ATLAS_ROOT}/.venv/bin/python3"
RUNTIME_DIR="${ATLAS_ROOT}/.runtime"
BACKEND_COMPOSE="${RUNTIME_DIR}/backend/docker-compose.yml"
ZABBIX_COMPOSE="${RUNTIME_DIR}/zabbix/docker-compose.yml"
PROXY_COMPOSE="${RUNTIME_DIR}/proxy/docker-compose.yml"
PROXY_CONFIG="${ATLAS_PROXY_CONFIG:-${RUNTIME_DIR}/proxy.yaml}"
OXIDIZED_INVENTORY_DIR="${ATLAS_OXIDIZED_RUN_DIR:-/run/atlas/oxidized}"

log() { printf '[INFO] %s\n' "$*"; }
die() { printf '[ERROR] %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
Usage:
  sudo atlasctl configure [--site-file FILE] [--check] [--force]
  sudo atlasctl components show
  sudo atlasctl components add oxidized|zabbix
  sudo atlasctl deploy [deploy_atlas.py options]
  sudo atlasctl status
  sudo atlasctl openbao
  sudo atlasctl oxidized reconcile
  sudo atlasctl oxidized host-key scan HOST [--port PORT] [--legacy-ssh]
  sudo atlasctl oxidized host-key accept HOST SHA256:FINGERPRINT [--port PORT] [--legacy-ssh]
  sudo atlasctl oxidized logs [docker compose logs options]
  sudo atlasctl zabbix status
  sudo atlasctl zabbix sync
  sudo atlasctl zabbix credentials
  sudo atlasctl zabbix logs [docker compose logs options]
  sudo atlasctl integrations cisco test
  sudo atlasctl inventory tenant add --name NAME [--dry-run]
  sudo atlasctl inventory site add --tenant TENANT --name NAME [--dry-run]
  sudo atlasctl inventory import FILE [--tenant TENANT] [--site SITE] [--dry-run|--apply]
  sudo atlasctl prophylaxis logs [docker compose logs options]
  sudo atlasctl backend logs [docker compose logs options]
  sudo atlasctl proxy logs [docker compose logs options]

Commands:
  configure             Create proxy, TLS and monitoring site configuration.
  components show       Show the fixed core and installed optional components.
  components add        Permanently add an optional component.
  deploy                Deploy or reconcile the full Atlas stack.
  status                Show Atlas container and Oxidized inventory state.
  openbao               Open the interactive OpenBao access helper.
  oxidized reconcile    Reconcile Oxidized runtime/inventory state.
  oxidized host-key     Scan or explicitly accept an SSH host key.
  oxidized logs         Show Oxidized container logs.
  zabbix status         Show Zabbix API and managed-host state.
  zabbix sync           Reconcile NetBox desired state into Zabbix.
  zabbix credentials    Show the HTTPS URL and administrator login.
  zabbix logs           Show Zabbix server, web, and database logs.
  integrations cisco    Test Cisco OAuth and Support API entitlements.
  inventory             Manage tenants/sites and import CSV/XLSX device inventory.
  prophylaxis logs      Show safe prophylaxis and Ansible diagnostic events.
  backend logs          Show Atlas backend container logs.
  proxy logs            Show Nginx ingress container logs.
EOF
}

require_root() {
    [[ ${EUID} -eq 0 ]] || die "Run atlasctl with sudo"
}

require_install() {
    id "$ATLAS_USER" >/dev/null 2>&1 || die "Atlas service account does not exist"
    [[ -x "$PYTHON" ]] || die "Atlas virtual environment is missing"
    [[ -d "$ATLAS_ROOT" ]] || die "Atlas installation is missing"
}

atlas_env() {
    local -a values=(
        "HOME=${ATLAS_HOME}"
        "USER=${ATLAS_USER}"
        "LOGNAME=${ATLAS_USER}"
        "PYTHONUNBUFFERED=1"
        "PATH=${ATLAS_ROOT}/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
        "ATLAS_PROXY_CONFIG=${PROXY_CONFIG}"
        "ATLAS_CALLER_CWD=${PWD}"
    )

    if [[ -n "${OPENBAO_URL:-}" ]]; then
        values+=("OPENBAO_URL=${OPENBAO_URL}")
    fi

    values+=("ATLAS_OXIDIZED_RUN_DIR=${OXIDIZED_INVENTORY_DIR}")

    printf '%s\0' "${values[@]}"
}

prepare_oxidized_inventory_runtime() {
    [[ "$OXIDIZED_INVENTORY_DIR" == /* ]] || \
        die "ATLAS_OXIDIZED_RUN_DIR must be an absolute path"

    install -d -m 0750 -o "$ATLAS_USER" -g "$ATLAS_GROUP" \
        "$OXIDIZED_INVENTORY_DIR"

    if [[ -L "${OXIDIZED_INVENTORY_DIR}/router.json" ]] || \
       [[ -e "${OXIDIZED_INVENTORY_DIR}/router.json" && \
          ! -f "${OXIDIZED_INVENTORY_DIR}/router.json" ]]; then
        die "Oxidized router.json must be a regular file, not a symlink"
    fi

    if [[ ! -e "${OXIDIZED_INVENTORY_DIR}/router.json" ]]; then
        printf '[]\n' > "${OXIDIZED_INVENTORY_DIR}/router.json"
    fi

    chown "$ATLAS_USER:$ATLAS_GROUP" \
        "${OXIDIZED_INVENTORY_DIR}/router.json"
    chmod 0640 "${OXIDIZED_INVENTORY_DIR}/router.json"
}

component_enabled() {
    cd "$ATLAS_ROOT"
    "$PYTHON" - "$1" <<'PY'
import sys
from atlas.components import load_components
raise SystemExit(0 if load_components().enabled(sys.argv[1]) else 1)
PY
}

require_component() {
    component_enabled "$1" || die "Atlas component '$1' is not installed"
}

show_components() {
    cd "$ATLAS_ROOT"
    "$PYTHON" "${ATLAS_ROOT}/scripts/configure_components.py" \
        --show --target-root "$ATLAS_ROOT"
}

add_component() {
    local name=$1
    [[ "$name" == "oxidized" || "$name" == "zabbix" ]] || \
        die "Optional component must be oxidized or zabbix"
    local selected
    selected="$(cd "$ATLAS_ROOT" && "$PYTHON" - "$name" <<'PY'
import sys
from atlas.components import load_components
current = set(load_components().optional)
current.add(sys.argv[1])
print(",".join(sorted(current)) or "none")
PY
)"
    "$PYTHON" "${ATLAS_ROOT}/scripts/configure_components.py" \
        --components "$selected" --target-root "$ATLAS_ROOT" \
        --owner "$ATLAS_USER" --group "$ATLAS_GROUP"
    if [[ "$name" == "oxidized" ]]; then
        install -m 0644 -o root -g root \
            "${ATLAS_ROOT}/deployment/tmpfiles.d/aricoma-atlas.conf" \
            /etc/tmpfiles.d/aricoma-atlas.conf
        systemd-tmpfiles --create /etc/tmpfiles.d/aricoma-atlas.conf
        prepare_oxidized_inventory_runtime
    fi
    printf '[INFO] Reconcile site TLS/hostname configuration, then run sudo atlasctl deploy.\n'
}

run_python_as_atlas() {
    local script=$1
    shift

    [[ -f "$script" ]] || die "Missing Atlas script: ${script}"

    local -a env_args=()
    while IFS= read -r -d '' item; do
        env_args+=("$item")
    done < <(atlas_env)

    cd "$ATLAS_ROOT"
    exec runuser -u "$ATLAS_USER" -- env "${env_args[@]}" \
        "$PYTHON" "$script" "$@"
}

configure_site() {
    local script="${ATLAS_ROOT}/scripts/configure_site.py"
    [[ -f "$script" ]] || die "Atlas site configurator is missing"
    cd "$ATLAS_ROOT"
    exec "$PYTHON" "$script" \
        --target-root "$ATLAS_ROOT" \
        --owner "$ATLAS_USER" \
        --group "$ATLAS_GROUP" \
        "$@"
}

show_status() {
    printf 'Atlas installation: %s\n' "$ATLAS_ROOT"
    printf 'Atlas service user: %s\n' "$ATLAS_USER"
    printf '\nContainers:\n'
    docker ps -a --format 'table {{.Names}}\t{{.Status}}\t{{.Networks}}' \
        | awk 'NR==1 || /atlas-/'

    printf '\nAtlas backend:\n'
    if [[ ! -f "$BACKEND_COMPOSE" ]]; then
        printf '  state: NOT_PREPARED\n'
    else
        local backend_container backend_state
        backend_container="$(
            docker compose -f "$BACKEND_COMPOSE" -p atlas-backend \
                ps -q backend 2>/dev/null || true
        )"
        if [[ -z "$backend_container" ]]; then
            printf '  state: STOPPED\n'
        else
            backend_state="$(
                docker inspect --format \
                    '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' \
                    "$backend_container" 2>/dev/null || printf 'UNKNOWN'
            )"
            printf '  state: %s\n' "$backend_state"
        fi
        printf '  health: http://127.0.0.1:8081/api/health\n'
    fi

    printf '\nZabbix:\n'
    if ! component_enabled zabbix; then
        printf '  state: NOT_SELECTED\n'
    elif [[ ! -f "$ZABBIX_COMPOSE" ]]; then
        printf '  state: NOT_PREPARED\n'
    else
        local zabbix_container zabbix_state
        zabbix_container="$(
            docker compose -f "$ZABBIX_COMPOSE" -p atlas-zabbix \
                ps -q server 2>/dev/null || true
        )"
        if [[ -z "$zabbix_container" ]]; then
            printf '  state: STOPPED\n'
        else
            zabbix_state="$(
                docker inspect --format \
                    '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' \
                    "$zabbix_container" 2>/dev/null || printf 'UNKNOWN'
            )"
            printf '  state: %s\n' "$zabbix_state"
        fi
        printf '  api: http://127.0.0.1:8081/api/zabbix/status\n'
    fi

    local source="${OXIDIZED_INVENTORY_DIR}/router.json"
    printf '\nOxidized:\n'

    if ! component_enabled oxidized; then
        printf '  state: NOT_SELECTED\n'
        return
    fi

    if [[ ! -f "$source" ]] || ! "$PYTHON" -c \
        'import json,sys; data=json.load(open(sys.argv[1])); raise SystemExit(0 if isinstance(data,list) and data else 1)' \
        "$source" 2>/dev/null; then
        printf '  state: WAITING_FOR_INVENTORY\n'
        printf '  source: %s\n' "$source"
        return
    fi

    printf '  state: INVENTORY_PRESENT\n'
    printf '  source: %s\n' "$source"
}

oxidized_logs() {
    local compose_file="${RUNTIME_DIR}/oxidized/docker-compose.yml"
    [[ -f "$compose_file" ]] || die "Oxidized runtime is not prepared"
    shift 0
    exec docker compose -f "$compose_file" -p atlas-oxidized logs "$@" oxidized
}

backend_logs() {
    [[ -f "$BACKEND_COMPOSE" ]] || die "Atlas backend runtime is not prepared"
    exec docker compose -f "$BACKEND_COMPOSE" -p atlas-backend logs "$@" backend
}

prophylaxis_logs() {
    [[ -f "$BACKEND_COMPOSE" ]] || die "Atlas backend runtime is not prepared"
    docker compose -f "$BACKEND_COMPOSE" -p atlas-backend \
        logs --no-color "$@" backend \
        | awk '
            /"event"[[:space:]]*:[[:space:]]*"ansible_execution_failed"/ ||
            /"event"[[:space:]]*:[[:space:]]*"ansible_runner_failed"/ ||
            /"event"[[:space:]]*:[[:space:]]*"prophylaxis_collection_completed"/ ||
            /"event"[[:space:]]*:[[:space:]]*"prophylaxis_collection_failed"/ ||
            /"event"[[:space:]]*:[[:space:]]*"prophylaxis_run_completed"/ ||
            /"event"[[:space:]]*:[[:space:]]*"prophylaxis_run_failed"/ ||
            /"event"[[:space:]]*:[[:space:]]*"prophylaxis_device_failed"/ ||
            /"event"[[:space:]]*:[[:space:]]*"prophylaxis_device_skipped"/
        '
}

proxy_logs() {
    [[ -f "$PROXY_COMPOSE" ]] || die "Nginx proxy runtime is not prepared"
    exec docker compose -f "$PROXY_COMPOSE" -p atlas-proxy logs "$@" proxy
}

zabbix_logs() {
    [[ -f "$ZABBIX_COMPOSE" ]] || die "Zabbix runtime is not prepared"
    exec docker compose -f "$ZABBIX_COMPOSE" -p atlas-zabbix logs "$@" \
        database server web
}

main() {
    require_root
    require_install

    local command=${1:-}
    case "$command" in
        configure)
            shift
            configure_site "$@"
            ;;
        deploy)
            shift
            [[ -f "$PROXY_CONFIG" ]] || \
                die "Atlas site proxy configuration is missing: ${PROXY_CONFIG}"
            if component_enabled oxidized; then
                prepare_oxidized_inventory_runtime
            fi
            run_python_as_atlas "${ATLAS_ROOT}/scripts/deploy_atlas.py" "$@"
            ;;
        components)
            shift
            case "${1:-}" in
                show)
                    shift
                    [[ $# -eq 0 ]] || die "components show accepts no options"
                    show_components
                    ;;
                add)
                    shift
                    [[ -n "${1:-}" && $# -eq 1 ]] || \
                        die "components add requires oxidized or zabbix"
                    add_component "$1"
                    ;;
                *)
                    usage
                    exit 2
                    ;;
            esac
            ;;
        status)
            shift
            show_status "$@"
            ;;
        openbao)
            shift
            run_python_as_atlas "${ATLAS_ROOT}/scripts/openbao_access.py" "$@"
            ;;
        inventory)
            shift
            case "${1:-}" in
                tenant|site|import)
                    run_python_as_atlas \
                        "${ATLAS_ROOT}/scripts/import_netbox_inventory.py" "$@"
                    ;;
                -h|--help|help)
                    run_python_as_atlas \
                        "${ATLAS_ROOT}/scripts/import_netbox_inventory.py" --help
                    ;;
                *)
                    usage
                    exit 2
                    ;;
            esac
            ;;
        oxidized)
            require_component oxidized
            shift
            case "${1:-}" in
                reconcile)
                    shift
                    prepare_oxidized_inventory_runtime
                    run_python_as_atlas "${ATLAS_ROOT}/scripts/deploy_oxidized.py" \
                        --reconcile-only "$@"
                    ;;
                host-key)
                    shift
                    prepare_oxidized_inventory_runtime
                    case "${1:-}" in
                        scan)
                            shift
                            [[ -n "${1:-}" ]] || die "Host is required"
                            local host=$1
                            shift
                            run_python_as_atlas \
                                "${ATLAS_ROOT}/scripts/deploy_oxidized.py" \
                                --host-key-scan "$host" "$@"
                            ;;
                        accept)
                            shift
                            [[ -n "${1:-}" && -n "${2:-}" ]] || \
                                die "Host and SHA256 fingerprint are required"
                            local host=$1 fingerprint=$2
                            shift 2
                            run_python_as_atlas \
                                "${ATLAS_ROOT}/scripts/deploy_oxidized.py" \
                                --host-key-accept "$host" "$fingerprint" "$@"
                            ;;
                        *)
                            usage
                            exit 2
                            ;;
                    esac
                    ;;
                logs)
                    shift
                    oxidized_logs "$@"
                    ;;
                *)
                    usage
                    exit 2
                    ;;
            esac
            ;;
        zabbix)
            require_component zabbix
            shift
            case "${1:-}" in
                status|sync)
                    local action=$1
                    shift
                    [[ $# -eq 0 ]] || die "zabbix ${action} accepts no options"
                    run_python_as_atlas \
                        "${ATLAS_ROOT}/scripts/zabbix_cli.py" "$action"
                    ;;
                credentials)
                    shift
                    [[ $# -eq 0 ]] || die "zabbix credentials accepts no options"
                    run_python_as_atlas \
                        "${ATLAS_ROOT}/scripts/zabbix_admin.py"
                    ;;
                logs)
                    shift
                    zabbix_logs "$@"
                    ;;
                *)
                    usage
                    exit 2
                    ;;
            esac
            ;;
        integrations)
            shift
            case "${1:-}" in
                cisco)
                    shift
                    [[ "${1:-}" == "test" && $# -eq 1 ]] || \
                        die "integrations cisco requires the test command"
                    cd "$ATLAS_ROOT"
                    exec "$PYTHON" \
                        "${ATLAS_ROOT}/scripts/cisco_support_cli.py"
                    ;;
                *)
                    usage
                    exit 2
                    ;;
            esac
            ;;
        backend)
            shift
            case "${1:-}" in
                logs)
                    shift
                    backend_logs "$@"
                    ;;
                *)
                    usage
                    exit 2
                    ;;
            esac
            ;;
        prophylaxis)
            shift
            case "${1:-}" in
                logs)
                    shift
                    prophylaxis_logs "$@"
                    ;;
                *)
                    usage
                    exit 2
                    ;;
            esac
            ;;
        proxy)
            shift
            case "${1:-}" in
                logs)
                    shift
                    proxy_logs "$@"
                    ;;
                *)
                    usage
                    exit 2
                    ;;
            esac
            ;;
        -h|--help|help|"")
            usage
            ;;
        *)
            usage
            exit 2
            ;;
    esac
}

main "$@"
